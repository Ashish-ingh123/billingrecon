# Settings for docker-compose.yml (local development only).
# Copy this file to .env and fill it in. Git ignores .env; never commit it.

# --- Licence terms ------------------------------------------------------------------------------
# Both images refuse to start until their licence is accepted. Accepting is your decision, so nothing
# is pre-filled: read the terms, then set each value to Y (a capital Y, nothing else).
#   SQL Server: the licence terms linked from https://hub.docker.com/r/microsoft/mssql-server
#   Seq:        https://datalust.co/doc/eula-current.pdf
MSSQL_ACCEPT_EULA=
SEQ_ACCEPT_EULA=

# --- SQL Server ---------------------------------------------------------------------------------
# Password of the sa login. Choose your own; this is a secret.
#   - 8 to 128 characters, with at least three of: upper case, lower case, digits, symbols.
#   - Avoid $ # ; = ' " \ and spaces: they are special to Compose or to connection strings.
#   - Too weak, and the container exits; `docker logs billingrecon-sql` says so.
#   - It is applied only when the sql-data volume is first created. Changing it here later does not
#     change the password of an existing volume.
MSSQL_SA_PASSWORD=

# --- Host ports ---------------------------------------------------------------------------------
# Change these if something else already listens there (for example a local SQL Server on 1433).
MSSQL_HOST_PORT=1433
SEQ_HOST_PORT=5341

# --- The one-command run (docs/runbook.md section 13) ------------------------------------------
# Passwords of the database logins of docs/runbook.md section 10; choose your own, with the same rules as the sa password.
BILLINGRECON_MIGRATOR_PASSWORD=
BILLINGRECON_APP_PASSWORD=

# The key the API signs its tokens with: base64 of at least 32 random bytes. One way, in PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SIGNING_KEY=

# The demo hospital (code "demo"): true to make it, with a week of bills and payments. Every demo user signs in with
# DEMO_PASSWORD (12 to 128 characters): admin@demo.local, supervisor@demo.local, clerk@demo.local,
# cashier@demo.local, viewer@demo.local.
DEMO_ENABLED=false
DEMO_PASSWORD=

# The address "Contact support" on the sign-in page writes to (ADR 0047). Built into the frontend image: after a change,
# docker compose up --build. Empty leaves the link out.
SUPPORT_EMAIL=

# Host ports of nginx. With other ports, open https://localhost:<port> yourself: the redirect from plain HTTP keeps 443.
HTTPS_HOST_PORT=443
HTTP_HOST_PORT=80

# --- The load test (docs/runbook.md section 14, ADR 0046) ---------------------------------------
# true only while a load test runs: the API's answers then say how long their number series was waited for and held
# (Server-Timing). Leave it false otherwise.
SERVER_TIMING=false
# The load: users (one patient and payer each), the posted bills the demo hospital is filled to first, the seconds that
# are measured and judged with a pause between one user's requests (milliseconds), and the seconds of a stress phase
# with no pause, reported but not judged (0 leaves it out). The run adds about 50 kB of data per bill, and the log grows:
# leave at least 2 GB free (docs/runbook.md section 14).
LOAD_USERS=50
LOAD_FILL_BILLS=10000
LOAD_SECONDS=120
LOAD_THINK_MS=1000
LOAD_STRESS_SECONDS=60
