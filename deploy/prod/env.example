# Settings of one environment of docker-compose.prod.yml (ADR 0055, docs/runbook.md section 19). Copy to
# /etc/billingrecon/env on the server (mode 600, root). NO SECRET BELONGS HERE: each secret is a file under SECRETS_DIR.

# --- Licences: read the terms, then Y ----------------------------------------------------------------------------
MSSQL_ACCEPT_EULA=
SEQ_ACCEPT_EULA=
# Let's Encrypt's subscriber agreement (https://letsencrypt.org/repository/).
CERTBOT_AGREE_TOS=

# The licensed edition of SQL Server 2022: Standard (needed for TDE), or the product key of the licence.
MSSQL_PID=Standard

# --- The release ------------------------------------------------------------------------------------------------
# Where the release workflow pushed the images, and the tag to run (set by the workflow at each deploy).
IMAGE_REGISTRY=ghcr.io/OWNER
IMAGE_TAG=

# Production on the production server, Staging on the staging server.
API_ENVIRONMENT=Production

# --- The name the hospital opens, and who Let's Encrypt writes to ------------------------------------------------
DOMAIN=billing.example.in
CERTBOT_EMAIL=

# --- Seq --------------------------------------------------------------------------------------------------------
# The hash of the admin password, not the password: docker run --rm datalust/seq config hash
SEQ_ADMIN_PASSWORD_HASH=

# --- Backups ----------------------------------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=35
# 20:00 UTC is 01:30 IST.
BACKUP_FULL_HOUR_UTC=20
# The rclone remote and path of the off-site copy, in a region of India (the remote is defined in the rclone.conf
# secret). Empty: no off-site copy is made, which is not acceptable for production.
OFFSITE_REMOTE=

# --- Secrets ----------------------------------------------------------------------------------------------------
# The directory itself mode 700 and owned by root; the files in it mode 444 (the containers do not run as root, and
# the directory is what keeps other users of the server out). Files, one value each, no line break needed:
#   mssql_sa_password      the administrator of SQL Server
#   migrator_password      the login billingrecon_migrator
#   app_password           the login billingrecon_app
#   api_connection_string  Server=sql;Database=BillingRecon;User Id=billingrecon_app;Password=<app_password>;Encrypt=True;TrustServerCertificate=True
#   jwt_signing_key        base64 of at least 32 random bytes: openssl rand -base64 48
#   rclone.conf            the off-site remote, with its own encryption (an rclone "crypt" remote is recommended)
SECRETS_DIR=/etc/billingrecon/secrets
