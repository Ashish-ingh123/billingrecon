<Project>

  <!--
    Central package management: every PackageReference in the repository takes its version from here.
    Adding a package needs approval first (CLAUDE.md, working agreement item 6).
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Packages that ship with the framework (ASP.NET Core, EF Core) follow the target framework in Directory.Build.props:
    same major version, current patch. Move them together (docs/adr/0014-target-framework-net10.md).
  -->

  <ItemGroup Label="Build (every project under src/, see src/Directory.Build.props)">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Application">
    <!--
      Validation of commands and queries in the use cases (CLAUDE.md section 2, ADR 0018). The API registers the
      validators with its own scan of the Application assembly, so FluentValidation.DependencyInjectionExtensions is
      not needed.
    -->
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.10" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <!--
      EF Core 10.0.12 asks for Microsoft.Data.SqlClient 6.1.6 or later; this pin is one major version ahead of that.
      The reasoning and the fallback (6.1.7) are in docs/adr/0014-target-framework-net10.md.
    -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!--
      Not used by any code here. A NuGet audit fix made on the personal machine on 2026-10-18: the restore reported an
      advisory against the version of this package that arrives transitively, and the Infrastructure project references
      it directly to lift it to a patched version. Remove the pin and the reference once the package that brings it in
      asks for a patched version itself.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <!-- EF Core: same version for the provider, the design-time package and the dotnet-ef tool (.config/dotnet-tools.json). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!-- Serilog.AspNetCore follows the major version of the target framework. -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- The Database collection of the integration tests: SQL Server 2022 in Docker, reset between tests, realistic data (ADR 0016). -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <!-- Code coverage for every test project, collected by dotnet test in CI (ADR 0017). -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

</Project>
